{
    "name": "xiaoyao/imgbed",
    "description": "XiaoYao ImageBed - self-hosted image hosting with API, payment and multi-storage",
    "type": "project",
    "keywords": ["imagebed", "thinkphp", "image-hosting"],
    "homepage": "https://github.com/cd1005-art/imgbed",
    "license": "MIT",
    "authors": [
        {
            "name": "cd1005-art",
            "homepage": "https://github.com/cd1005-art"
        }
    ],
    "require": {
        "php": ">=8.1.0",
        "topthink/framework": "~8.1.3",
        "topthink/think-orm": "^3.0|^4.0",
        "topthink/think-filesystem": "^2.0|^3.0",
        "topthink/think-multi-app": "^1.1",
        "phpmailer/phpmailer": "^6.9",
        "topthink/think-template": "^3.0",
        "topthink/think-view": "^2.0"
    },
    "config": {
        "preferred-install": "dist"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        },
        "psr-0": {
            "": "extend/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    }
}
