{
    "name": "xiaoyao/imgbed",
    "description": "XiaoYao ImageBed - self-hosted image hosting with API, payment and multi-storage",
    "type": "project",
    "keywords": ["imagebed", "thinkphp", "image-hosting"],
    "homepage": "https://github.com/xiaoyao/imgbed",
    "license": "MIT",
    "authors": [
        {
            "name": "XiaoYao",
            "email": "admin@xiaoyao.net"
        }
    ],
    "require": {
        "php": ">=8.1.0",
        "topthink/framework": "~8.1.3",
        "topthink/think-orm": "^3.0|^4.0",
        "topthink/think-filesystem": "^2.0|^3.0",
        "topthink/think-multi-app": "^1.1",
        "topthink/think-template": "^3.0",
        "topthink/think-view": "^2.0"
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            true
        }
    },
    "require-dev": {
        "topthink/think-trace": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        },
        "psr-0": {
            "": "extend/"
        }
    },
    "config": {
        "preferred-install": "dist"
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    },
    "repositories": [{
        "name": "packagist",
        "type": "composer",
        "url": "https://mirrors.aliyun.com/composer/"
    }]
}
